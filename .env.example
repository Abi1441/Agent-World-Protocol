# Agent World Protocol — Environment Configuration
# Copy to .env if you want to override defaults. Never commit .env or private keys.
# The server loads this file automatically via dotenv.
#
# SAFE DEFAULTS (used when a variable is unset):
#   SOLANA_RPC = https://api.devnet.solana.com
#   DRY_RUN    = true          (simulated economy, no real SOL)
#   guest play = allowed
# Mainnet is refused unless you set ALLOW_MAINNET=true yourself.

# Server port (HTTP + WebSocket on the same port)
PORT=3000

# Simulation
TICK_RATE=1000

# World config (64 matches the in-game zone size)
PERCEPTION_RADIUS=10
ZONE_SIZE=64

# Solana cluster. Use devnet or a local validator. Do not put a mainnet URL here.
SOLANA_NETWORK=devnet
SOLANA_RPC=https://api.devnet.solana.com
# Local validator example:
# SOLANA_RPC=http://127.0.0.1:8899
# SOLANA_NETWORK=localnet

# Keep true. false would allow bridge code to build live transactions.
# Even then, this app does not ship a funded signer.
DRY_RUN=true

# Explicit opt-in required before any mainnet RPC is accepted. Leave unset.
# ALLOW_MAINNET=

# Optional protocol fee wallet (public address only — never a private key)
FEE_WALLET=

# Simulated starting purse for each new player, in lamports. Default is 2 SOL when DRY_RUN=true.
# STARTER_GRANT_LAMPORTS=2000000000

# PostgreSQL — world persists across restarts when set. Omit for memory-only.
# DATABASE_URL=postgresql://awp:awp_dev@localhost:5432/agentworld
DATABASE_URL=

# Auto-save interval (ms)
DB_SAVE_INTERVAL=30000

# Wallet signatures. false = guest play (any browser can join).
# true = connecting clients must sign the server challenge with a Solana key.
REQUIRE_WALLET_AUTH=false

# HMAC secret for signed operator endpoints. Generate one locally; do not commit it.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_SECRET=

# Secret for admin reset/cleanup. Generate locally; do not commit it.
ADMIN_KEY=

# Comma-separated allowed origins. Empty = allow all (fine for local play).
CORS_ORIGINS=
